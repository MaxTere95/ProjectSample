---------------------------------------------DocRowDBO
selectRowsByDocID:
    SELECT * FROM DocRowDBO
    WHERE idDoc = ?
    ORDER BY id DESC;

saveRow:
    INSERT OR REPLACE INTO DocRowDBO VALUES ?;

deleteRowsByDocID:
    DELETE FROM DocRowDBO WHERE idDoc = ?;




