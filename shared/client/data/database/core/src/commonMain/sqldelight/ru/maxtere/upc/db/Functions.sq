---------------------------------------------DocDBO
selectAllDocs:
    SELECT * FROM DocDBO
    ORDER BY id DESC;

saveDoc:
    INSERT OR REPLACE INTO DocDBO VALUES ?;

deleteDocByID:
    DELETE FROM DocDBO WHERE id = ?;

getMaxIDDoc:
    SELECT MAX(id) maxID FROM DocDBO;



